<div style="max-width: 900px; margin: 40px auto; padding: 24px; font-family: Arial, sans-serif; color: #172033;">
  <header style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
    <div>
      <h1 style="margin-bottom: 6px;">My Todo List</h1>
      <p style="color: #667085; margin-top: 0;">Organize your tasks and get things done.</p>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <%= link_to "＋ New Todo", new_todo_path, style: "background: #2563eb; color: white; padding: 12px 18px; border-radius: 8px; text-decoration: none;" %>
      <%= button_to "Logout", destroy_user_session_path, method: :delete, style: "padding: 12px; cursor: pointer; border: 1px solid #d0d5dd; border-radius: 8px; background: white;" %>
    </div>
  </header>

  <% if notice.present? %>
    <p style="background: #dcfce7; color: #166534; padding: 12px; border-radius: 8px;"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p style="background: #fee2e2; color: #991b1b; padding: 12px; border-radius: 8px;"><%= alert %></p>
  <% end %>

  <section style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 26px;">
    <h2 style="margin: 0;">Your tasks</h2>
    <%= form_with url: todos_path, method: :get, local: true, style: "display: flex; gap: 8px; align-items: center;" do %>
      <%= label_tag :status, "Filter" %>
      <%= select_tag :status, options_for_select([["All tasks", "all"], ["Pending", "pending"], ["Completed", "completed"]], @status), style: "padding: 9px; border: 1px solid #d0d5dd; border-radius: 8px;" %>
      <%= submit_tag "Apply", style: "padding: 9px 12px; cursor: pointer; border: 0; border-radius: 8px; background: #e5e7eb;" %>
    <% end %>
  </section>

  <div style="margin-top: 18px;">
    <% if @todos.any? %>
      <% @todos.each do |todo| %>
        <article style="border: 1px solid #e4e7ec; border-radius: 12px; padding: 20px; margin-bottom: 14px; background: white;">
          <div style="display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
            <h3 style="margin: 0 0 8px; overflow-wrap: anywhere;"><%= todo.title %></h3>
            <span style="height: fit-content; padding: 5px 10px; border-radius: 999px; font-size: 13px; background: <%= todo.completed? ? '#dcfce7' : '#fef3c7' %>; color: <%= todo.completed? ? '#166534' : '#92400e' %>;">
              <%= todo.completed? ? "Completed" : "Pending" %>
            </span>
          </div>
          <p style="color: #667085; white-space: pre-wrap;"><%= todo.description.presence || "No description provided." %></p>
          <div style="display: flex; gap: 14px; align-items: center;">
            <%= link_to "Edit", edit_todo_path(todo) %>
            <%= button_to "Delete", todo_path(todo), method: :delete, data: { turbo_confirm: "Delete this todo?" }, style: "color: #b42318; background: white; border: 0; cursor: pointer; padding: 0;" %>
          </div>
        </article>
      <% end %>
    <% else %>
      <div style="text-align: center; padding: 50px 20px; border: 1px dashed #d0d5dd; border-radius: 12px; background: #f9fafb;">
        <h2>No tasks found</h2>
        <p style="color: #667085;">Create your first todo or try another filter.</p>
        <%= link_to "Create your first todo", new_todo_path, style: "color: #2563eb;" %>
      </div>
    <% end %>
  </div>
</div>
